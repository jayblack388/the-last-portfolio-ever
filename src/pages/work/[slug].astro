---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getWork } from "../../lib/work";

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} | John Blackwell`} description={entry.data.summary}>
  <p class="crumb"><a href="/work">All work</a></p>
  <h1>{entry.data.title}</h1>
  <p class="lead">{entry.data.summary}</p>
  <div class="prose">
    <Content />
  </div>
  {
    entry.data.links.length > 0 && (
      <>
        <h2>Links</h2>
        <ul>
          {entry.data.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<style>
  .lead {
    font-size: 1.15rem;
    color: var(--muted);
  }
  .crumb {
    margin-top: 2rem;
  }
  .prose {
    max-width: 42rem;
  }
</style>
