---
import { cleanPath, navCurrent } from "../lib/paths";
import { site } from "../site";
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { href: "/work", label: "Work" },
  { href: "/blog", label: "Blog" },
  { href: "/nonprofits", label: "Nonprofits" },
  { href: "/about", label: "About" },
];
const current = cleanPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="container bar">
    <a class="home" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={navCurrent(current, item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-block: 1rem;
  }
  .home {
    font-family: "Courier Prime", "Courier New", monospace;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--text);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  [aria-current="page"] {
    font-weight: 700;
  }
</style>
